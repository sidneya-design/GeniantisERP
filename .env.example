# Supabase - Conexão do Frontend
# Obtenha em Project Settings -> API no painel do Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-public-key-aqui

# Informações da Organização
VITE_ORGANIZATION_NAME=Geniantis


# Functions da Netlify em `npm run dev:netlify` (só no .env local, nunca no Git).
# Copie os valores das variáveis do site na Netlify.
SUPABASE_SERVICE_ROLE_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Conta separada dos Comunicados (rh@geniantis.org) e a senha de app dela
COMUNICADOS_GMAIL_USER=
COMUNICADOS_GMAIL_APP_PASSWORD=
